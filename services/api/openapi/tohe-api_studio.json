  "components": {
    "schemas": {
      "ApproveRequest": {
        "required": [
          "allowShareAlike",
          "shareAlikeReason"
        ],
        "type": "object",
        "properties": {
          "allowShareAlike": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "shareAlikeReason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AssetFrames": {
        "required": [
          "width",
          "height",
          "count"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AssetInput": {
        "required": [
          "id",
          "kind",
          "sha256",
          "ext",
          "bytes",
          "width",
          "height",
          "frames",
          "wang",
          "tags",
          "licence",
          "attribution",
          "source"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ]
          },
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "sha256": {
            "type": [
              "null",
              "string"
            ]
