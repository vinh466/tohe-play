{
  "openapi": "3.1.1",
  "info": {
    "title": "Tò He Studio API",
    "description": "The Asset Studio's API (ADR 0051), with its own session. Every endpoint past the sign-in needs a studio role.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/studio/session": {
      "get": {
        "tags": [
          "Studio"
        ],
        "summary": "The account signed in to the Studio: its studio role, what the role may do, and its session; 204 when nobody is.",
        "operationId": "GetStudioSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudioMeView"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      },
      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "Sign in to the Studio: email, password, and a code when two-factor authentication is on; sets the Studio's own session cookie for twelve hours.",
        "operationId": "SignInToStudio",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudioSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudioMeView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Studio"
        ],
        "summary": "End the Studio's session on this browser; the hub's and the console's stay.",
        "operationId": "SignOutOfStudio",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/studio/session/step-up": {
      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "A fresh code from the authenticator opens step-up for review actions in this Studio session for 10 minutes.",
        "operationId": "StepUpInStudio",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudioStepUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudioMeView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "StudioMeView": {
        "required": [
          "accountId",
          "displayName",
          "email",
          "role",
          "permissions",
          "twoFactorEnabled",
          "openUntil",
          "secureUntil"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "openUntil": {
            "type": "string",
            "format": "date-time"
          },
          "secureUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "StudioSignInRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "recoveryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StudioStepUpRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Studio"
    }
  ]
}