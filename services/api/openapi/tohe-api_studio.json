      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "Run every check of a submission on a draft as it stands — the files uploaded so far — and save nothing.",
        "operationId": "CheckStudioDraft",
        "parameters": [
          {
            "name": "versionId",
            "in": "path",
