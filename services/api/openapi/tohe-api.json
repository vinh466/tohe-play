{
  "openapi": "3.1.1",
  "info": {
    "title": "Tò He Platform API",
    "description": "Backend for the Tò He hub. Games never call it directly; see docs/contracts.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/config": {
      "get": {
        "tags": [
          "Platform"
        ],
        "summary": "Runtime configuration for the hub.",
        "operationId": "GetConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles/options": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Allowed avatars and age bands.",
        "operationId": "GetProfileOptions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileOptionsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Create an adult account: a new household, or join one with an invite code.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Sign in; sets the session cookie.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Sign out this device.",
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "The device session (account, household, profiles, active profile, parent gate); 204 when signed out.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/session/profile": {
      "put": {
        "tags": [
          "Identity"
        ],
        "summary": "Choose who plays on this device. Locks the parent gate.",
        "operationId": "SelectProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "Identity"
        ],
        "summary": "Back to the profile picker.",
        "operationId": "ClearProfile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/parent-gate": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Re-enter the password to manage the household for a few minutes.",
        "operationId": "UnlockParentGate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentGateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Identity"
        ],
        "summary": "Lock household management again.",
        "operationId": "LockParentGate",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/household": {
      "patch": {
        "tags": [
          "Identity"
        ],
        "summary": "Rename the household.",
        "operationId": "UpdateHousehold",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateHouseholdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/household/invite": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "New invite code for another adult (replaces the previous one).",
        "operationId": "CreateInvite",
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Identity"
        ],
        "summary": "Revoke the invite code.",
        "operationId": "RevokeInvite",
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          }
        }
      }
    },
    "/api/household/profiles": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Add a child profile.",
        "operationId": "CreateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/household/profiles/{id}": {
      "patch": {
        "tags": [
          "Identity"
        ],
        "summary": "Edit a profile. Adults can only edit their own adult profile.",
        "operationId": "UpdateProfile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Identity"
        ],
        "summary": "Remove a child profile.",
        "operationId": "DeleteProfile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/games": {
      "get": {
        "tags": [
          "Registry"
        ],
        "summary": "Games available in the hub, filtered by the active profile's age band.",
        "operationId": "ListGames",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "tags": [
          "Registry"
        ],
        "summary": "One game by id (not found if the active profile is too young for it).",
        "operationId": "GetGame",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountView": {
        "required": [
          "id",
          "username",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "ClientConfig": {
        "required": [
          "gamesOrigin",
          "apiVersion"
        ],
        "type": "object",
        "properties": {
          "gamesOrigin": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          }
        }
      },
      "CreateProfileRequest": {
        "required": [
          "name",
          "avatar",
          "ageBand"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "ageBand": {
            "type": "string"
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GameSummary": {
        "required": [
          "id",
          "name",
          "version",
          "description",
          "entryUrl",
          "iconUrl",
          "orientation",
          "capabilities",
          "tags",
          "minAge",
          "sizeKb"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "entryUrl": {
            "type": "string"
          },
          "iconUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "orientation": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minAge": {
            "type": "integer",
            "format": "int32"
          },
          "sizeKb": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HouseholdView": {
        "required": [
          "id",
          "name",
          "members",
          "invite"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberView"
            }
          },
          "invite": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InviteView"
              }
            ]
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "InviteView": {
        "required": [
          "code",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeView": {
        "required": [
          "account",
          "household",
          "profiles",
          "activeProfileId",
          "parentUnlockedUntil"
        ],
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountView"
          },
          "household": {
            "$ref": "#/components/schemas/HouseholdView"
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileView"
            }
          },
          "activeProfileId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "parentUnlockedUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "MemberView": {
        "required": [
          "accountId",
          "displayName",
          "username"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "ParentGateRequest": {
        "required": [
          "password"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileOptionsView": {
        "required": [
          "avatars",
          "ageBands"
        ],
        "type": "object",
        "properties": {
          "avatars": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ageBands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProfileView": {
        "required": [
          "id",
          "name",
          "avatar",
          "kind",
          "ageBand",
          "hasPin",
          "isMine"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "ageBand": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasPin": {
            "type": "boolean"
          },
          "isMine": {
            "type": "boolean"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "displayName",
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "householdName": {
            "type": [
              "null",
              "string"
            ]
          },
          "inviteCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SelectProfileRequest": {
        "required": [
          "profileId"
        ],
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "format": "uuid"
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateHouseholdRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "avatar": {
            "type": [
              "null",
              "string"
            ]
          },
          "ageBand": {
            "type": [
              "null",
              "string"
            ]
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          },
          "removePin": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Platform"
    },
    {
      "name": "Identity"
    },
    {
      "name": "Registry"
    }
  ]
}