{
  "name": "@tohe/api",
  "version": "0.1.0",
  "private": true,
  "description": "Turborepo wrapper around the .NET solution, so `pnpm build|test|dev` covers the API too.",
  "scripts": {
    "dev": "DOTNET_USE_POLLING_FILE_WATCHER=1 DOTNET_WATCH_SUPPRESS_STATIC_FILE_HANDLING=1 dotnet watch --project src/Tohe.Api --launch-profile http",
    "build": "dotnet build Tohe.slnx",
    "test": "dotnet test --solution Tohe.slnx"
  },
  "devDependencies": {
    "@tohe/game-tien-len": "workspace:*"
  }
}
