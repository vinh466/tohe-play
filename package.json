{
  "name": "tohe-play",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "conformance": "turbo run conformance",
    "lint": "biome check .",
    "format": "biome check --write .",
    "stack:image": "bash scripts/stack-image.sh",
    "seed": "bash scripts/seed.sh",
    "check:uat": "node tools/env-check/src/uat.ts",
    "check:prod": "node tools/env-check/src/prod.ts",
    "release:check": "node tools/env-check/src/release.ts",
    "claims": "node tools/claims/src/cli.ts",
    "assets:resolve": "node tools/assets/src/cli.ts resolve",
    "assets:check": "node tools/assets/src/cli.ts check",
    "verify": "sh scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
