---
// /games/<gameId>/ and /en/games/<gameId>/: one page for each game that has a game.json (../content/games.ts). The
// name, what it is, the age and how it is played come from the game's manifest; the how-to and who it suits from the
// game's copy in the page's language.
import { type Game, gamesPage } from '../content/games.ts';
import { absolute } from '../content/site.ts';
import { appPath, localPath, pageLanguage } from '../i18n.ts';
import Page from '../layouts/Page.astro';

interface Props {
  game: Game;
  others: Game[];
}

const { game, others } = Astro.props;
const lang = pageLanguage(Astro.currentLocale);
const words = gamesPage[lang];
const path = localPath(lang, `/games/${game.id}/`);
const jsonLd = [
  {
    '@type': 'VideoGame',
    name: game.name,
    description: game.metaDescription,
    url: absolute(path),
    image: absolute(game.icon),
    inLanguage: lang,
    genre: game.genre,
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    playMode: game.playMode,
    ...(game.seats
      ? {
          numberOfPlayers: {
            '@type': 'QuantitativeValue',
            minValue: game.seats.min,
            maxValue: game.seats.max,
          },
        }
      : {}),
    audience: { '@type': 'PeopleAudience', suggestedMinAge: game.minAge },
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'VND', availability: 'https://schema.org/InStock' },
    publisher: { '@id': absolute('/#organization') },
    isPartOf: { '@id': absolute(`${localPath(lang, '/')}#website`) },
  },
];
---

<Page title={game.title} description={game.metaDescription} path={path} jsonLd={jsonLd}>
  <main id="main" class="narrow">
    <a class="crumb" href={localPath(lang, '/games/')}>{words.back}</a>
    <div class="game-head">
      <img src={game.icon} alt="" width="96" height="96" />
      <div>
        <h1>{game.name}</h1>
        <ul class="chips">{game.facts.map((fact) => <li>{fact}</li>)}</ul>
      </div>
    </div>
    <p class="game-intro">{game.description}</p>
    <div class="actions">
      <a class="button primary" href={appPath(lang, `/play/${game.id}`)}>{words.playNow}</a>
    </div>
    <p class="lead">{words.noAccount}</p>

    {
      game.copy && (
        <section>
          <h2>{words.howTo}</h2>
          <ol class="steps panel">{game.copy.howTo.map((line) => <li>{line}</li>)}</ol>
        </section>
      )
    }
    {
      game.copy && (
        <section>
          <h2>{words.suits}</h2>
          <p>{game.copy.suits}</p>
        </section>
      )
    }

    {
      others.length > 0 && (
        <section>
          <h2>{words.others}</h2>
          <ul class="cards">
            {others.map((other) => (
              <li>
                <div class="card">
                  <div class="card-head">
                    <img class="card-icon" src={other.icon} alt="" width="48" height="48" />
                    <h3 class="card-title">
                      <a href={localPath(lang, `/games/${other.id}/`)}>{other.name}</a>
                    </h3>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p><a href={localPath(lang, '/guides/install/')}>{words.install}</a></p>
  </main>
</Page>
