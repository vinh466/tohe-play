---
// /games/<gameId>/ and /en/games/<gameId>/: a game's page as a small store page (ADR 0056) — a 16:9 cover, the name,
// one line, Play and Play together, facts as chips, pictures when the game has them, how to play, its questions, the
// full facts table and the other games. The words and facts come from the game's own folder (ADR 0047); the page's
// link preview is its own picture, drawn by `generate:og` and committed beside the page.
import { type Game, gamesPage } from '../content/games.ts';
import { absolute } from '../content/site.ts';
import { appPath, localPath, pageLanguage } from '../i18n.ts';
import Page from '../layouts/Page.astro';
import playbarUrl from '../scripts/game-playbar.js?url';
import UpdatedOn from './UpdatedOn.astro';

interface Props {
  game: Game;
  others: Game[];
}

const { game, others } = Astro.props;
const lang = pageLanguage(Astro.currentLocale);
const words = gamesPage[lang];
const path = localPath(lang, `/games/${game.id}/`);
const { page } = game;
const play = appPath(lang, `/play/${game.id}`);
const rooms = appPath(lang, `/play/${game.id}/rooms`);
const cover = game.pictures[0]?.src ?? game.icon;
const ageLabel = lang === 'vi' ? 'Tuổi' : 'Age';
const chips = game.facts.filter((fact) => fact.label !== ageLabel).slice(0, 4);
const jsonLd = [
  {
    '@type': 'VideoGame',
    name: game.name,
    description: game.metaDescription,
    url: absolute(path),
    image: absolute(cover),
    inLanguage: lang,
    genre: game.genre,
    gamePlatform: 'Web browser',
    applicationCategory: 'Game',
    operatingSystem: 'Any',
    playMode: game.playMode,
    ...(game.seats
      ? {
          numberOfPlayers: {
            '@type': 'QuantitativeValue',
            minValue: game.seats.min,
            maxValue: game.seats.max,
          },
        }
      : {}),
    audience: { '@type': 'PeopleAudience', suggestedMinAge: game.minAge },
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'VND', availability: 'https://schema.org/InStock' },
    dateModified: page.updated,
    publisher: { '@id': absolute('/#organization') },
    isPartOf: { '@id': absolute(`${localPath(lang, '/')}#website`) },
  },
  {
    '@type': 'BreadcrumbList',
    inLanguage: lang,
    itemListElement: [
      { name: words.home, path: localPath(lang, '/') },
      { name: words.heading, path: localPath(lang, '/games/') },
      { name: game.name, path },
    ].map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: absolute(crumb.path),
    })),
  },
];
---

<Page
  title={game.title}
  description={game.metaDescription}
  path={path}
  image={{ path: `${path}og.png`, alt: `${game.name} — ${page.kind}` }}
  jsonLd={jsonLd}
>
  <main id="main" class="game-page">
    <a class="crumb" href={localPath(lang, '/games/')}>{words.back}</a>

    <section class="game-hero" aria-labelledby="game-title">
      <div class="game-cover">
        <img src={cover} alt="" width="1280" height="720" />
      </div>
      <div class="game-info">
        <p class="eyebrow">{game.genre.length > 0 ? game.genre.join(' · ') : page.kind}</p>
        <h1 id="game-title">{game.name}</h1>
        <p class="lead">{page.kind}</p>
        <div class="actions start">
          <a class="button primary" href={play}>{words.play}</a>
          {
            game.together && (
              <a class="button secondary" href={rooms}>
                {words.playTogether}
              </a>
            )
          }
        </div>
        {
          chips.length > 0 && (
            <ul class="fact-chips" aria-label={words.facts}>
              {chips.map((fact) => <li>{fact.value}</li>)}
            </ul>
          )
        }
      </div>
    </section>

    <div class="game-body">
      <div>
        <p class="game-intro">{page.answer}</p>

        {
          game.pictures.length > 0 && (
            <section>
              <h2>{words.pictures}</h2>
              <div class="game-shots">
                {game.pictures.map((picture) => (
                  <img src={picture.src} alt={picture.alt} loading="lazy" />
                ))}
              </div>
            </section>
          )
        }

        <section>
          <h2>{words.howTo}</h2>
          <ol class="steps panel">{page.howTo.map((line) => <li>{line}</li>)}</ol>
        </section>

        {
          page.suits && (
            <section>
              <h2>{words.suits}</h2>
              <p>{page.suits}</p>
            </section>
          )
        }

        {
          page.questions.length > 0 && (
            <section>
              <h2>{words.questions}</h2>
              {page.questions.map(({ q, a }) => (
                <div class="panel question">
                  <h3>{q}</h3>
                  <p>{a}</p>
                </div>
              ))}
            </section>
          )
        }

        <section>
          <h2>{words.facts}</h2>
          <table class="facts">
            <tbody>
              {
                game.facts.map((fact) => (
                  <tr>
                    <th scope="row">{fact.label}</th>
                    <td>{fact.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>
      </div>

      {
        others.length > 0 && (
          <aside class="game-others-box">
            <h2>{words.others}</h2>
            <div class="game-others">
              {others.map((other) => (
                <a href={localPath(lang, `/games/${other.id}/`)}>
                  <img src={other.pictures[0]?.src ?? other.icon} alt="" width="160" height="90" loading="lazy" />
                  <span>
                    <strong>{other.name}</strong>
                    <span class="small">{other.page.kind}</span>
                  </span>
                </a>
              ))}
            </div>
          </aside>
        )
      }
    </div>

    <p><a href={localPath(lang, '/guides/install/')}>{words.install}</a></p>
    <UpdatedOn day={page.updated} />
  </main>

  <div class="game-playbar">
    <a class="button primary" href={play}>{words.play}</a>
    {
      game.together && (
        <a class="button secondary" href={rooms}>
          {words.playTogether}
        </a>
      )
    }
  </div>
  <script is:inline src={playbarUrl}></script>
</Page>
