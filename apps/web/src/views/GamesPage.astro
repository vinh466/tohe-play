---
// /games/ and /en/games/: every game on the shelf, from its own game.json (../content/games.ts). A new game appears here
// by itself. The cards are the shelf's own (ADR 0056): a 16:9 cover, the name, one line, a tag and Play.
import { gamesPage, loadGames } from '../content/games.ts';
import { absolute } from '../content/site.ts';
import { appPath, localPath, pageLanguage } from '../i18n.ts';
import Page from '../layouts/Page.astro';

const lang = pageLanguage(Astro.currentLocale);
const words = gamesPage[lang];
const path = localPath(lang, '/games/');
const games = loadGames(lang);
const metaOf = (game: (typeof games)[number]) =>
  [
    game.genre[0],
    game.seats
      ? `${game.seats.min}–${game.seats.max} ${lang === 'vi' ? 'người' : 'players'}`
      : lang === 'vi'
        ? 'Một mình'
        : 'One player',
  ]
    .filter(Boolean)
    .join(' · ');
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: words.heading,
    description: words.description,
    url: absolute(path),
    inLanguage: lang,
    isPartOf: { '@id': absolute(`${localPath(lang, '/')}#website`) },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: games.map((game, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: absolute(localPath(lang, `/games/${game.id}/`)),
        name: game.name,
      })),
    },
  },
];
---

<Page title={words.title} description={words.description} path={path} jsonLd={jsonLd}>
  <main id="main" class="shelf">
    <h1>{words.heading}</h1>
    <p class="lead">{words.lead}</p>
    <ul class="shelf-grid">
      {
        games.map((game) => (
          <li>
            <article class="shelf-card">
              <a class="shelf-cover" href={localPath(lang, `/games/${game.id}/`)} aria-hidden="true" tabindex="-1">
                <img src={game.pictures[0]?.src ?? game.icon} alt="" width="640" height="360" loading="lazy" />
              </a>
              <div class="shelf-card-body">
                <h2><a href={localPath(lang, `/games/${game.id}/`)}>{game.name}</a></h2>
                <p class="shelf-kind">{game.page.kind}</p>
                <p class="shelf-meta">{metaOf(game)}</p>
                <a class="shelf-play" href={appPath(lang, `/play/${game.id}`)}>{words.play}</a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p><a href={localPath(lang, '/guides/install/')}>{words.install}</a></p>
  </main>
</Page>
