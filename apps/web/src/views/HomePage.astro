---
import { latestDay } from '../content/game-page.ts';
// The public home page, / in Vietnamese and /en/ in English (ADR 0042, 0046, 0047): the catalog first — a big tile for
// each game, leading to its page — under one line that says what Tò He is, then *Chơi ngay* into the app; below, playing
// together, installing, the questions, the story and the promise, and the day it was last revised. It never redirects:
// a browser that has opened a game here gets *Chơi tiếp* at the top (../scripts/returning.js marks it before the first
// paint). The developer docs are linked from the footer only, so a page the app opens shows no link out of Tò He.
// The words are in ../content/home.ts.
import { loadGames, offlineEverywhere } from '../content/games.ts';
import { home } from '../content/home.ts';
import { absolute, site } from '../content/site.ts';
import { appPath, localPath, pageLanguage } from '../i18n.ts';
import Page from '../layouts/Page.astro';
import UpdatedOn from './UpdatedOn.astro';

const lang = pageLanguage(Astro.currentLocale);
const words = home[lang];
const path = localPath(lang, '/');
const games = loadGames(lang);
const together = games.filter((game) => game.together);
const updated = latestDay([words.updated, ...games.map((game) => game.page.updated)]);
const gamePath = (id: string) => localPath(lang, `/games/${id}/`);
const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': absolute(`${path}#website`),
    url: absolute(path),
    name: site.name,
    description: words.description,
    inLanguage: lang,
    dateModified: updated,
    publisher: { '@id': absolute('/#organization') },
  },
  {
    '@type': 'Organization',
    '@id': absolute('/#organization'),
    name: site.name,
    url: absolute('/'),
    logo: absolute('/icon-512.png'),
    description: words.organization.description,
    email: site.email,
    sameAs: [site.github],
  },
  {
    '@type': 'ItemList',
    name: words.games.heading,
    inLanguage: lang,
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(gamePath(game.id)),
      name: game.name,
    })),
  },
];
---

<Page title={words.title} description={words.description} path={path} jsonLd={jsonLd}>
  <main id="main" class="full">
    <div class="hero">
      <p class="continue"><a class="button primary" href={appPath(lang, '/play')}>{words.continue}</a></p>
      <h1>{site.name}</h1>
      <p class="lead">{words.line}</p>
    </div>

    <div class="container">
      <section aria-labelledby="games">
        <h2 id="games">{words.games.heading}</h2>
        <ul class="tiles">
          {
            games.map((game) => (
              <li>
                <a class="tile" href={gamePath(game.id)}>
                  <img src={game.icon} alt="" width="80" height="80" />
                  <span class="tile-name">{game.name}</span>
                  <span class="tile-kind">{game.page.kind}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <a class="button primary" href={appPath(lang, '/play')}>{words.play}</a>
        </div>
        <p class="hint">
          <a href={localPath(lang, '/games/')}>{words.games.all}</a>
          <a href={localPath(lang, '/guides/install/')}>{words.installHint}</a>
        </p>
      </section>

      <section class="band">
        <h2>{words.friends.heading}</h2>
        <p>{words.friends.text}</p>
        {
          together.length > 0 && (
            <p>
              {words.friends.games}{' '}
              {together.map((game, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={gamePath(game.id)}>{game.name}</a>
                </>
              ))}
            </p>
          )
        }
      </section>

      <section class="band">
        <h2>{words.install.heading}</h2>
        <p>{words.install.text}{offlineEverywhere() && ` ${words.install.offline}`}</p>
        <a class="more" href={localPath(lang, '/guides/install/')}>{words.install.link}</a>
      </section>

      <section class="band">
        <h2>{words.questions.heading}</h2>
        <p>{words.questions.text}</p>
        <a class="more" href={localPath(lang, '/faq/')}>{words.questions.link}</a>
      </section>

      <section class="band">
        <h2>{words.story.heading}</h2>
        <p>{words.story.text}</p>
      </section>

      <section class="band">
        <h2>{words.promise.heading}</h2>
        <p>{words.promise.text}</p>
        <a class="more" href={localPath(lang, '/promise/')}>{words.promise.link}</a>
      </section>

      <UpdatedOn day={updated} />
    </div>
  </main>
</Page>
