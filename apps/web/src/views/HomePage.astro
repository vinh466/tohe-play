---
// The home page, / and /en/ (ADR 0056): the shelf. A hero game, the games open now, the greeting of a device that has
// played, a quick row, the table band and every game. The story of what Tò He is lives in About; the parents' page in
// /family/; the install guide and questions in /guides/ and /faq/. The words are in ../content/home.ts.
import { latestDay } from '../content/game-page.ts';
import { loadGames } from '../content/games.ts';
import { home } from '../content/home.ts';
import { absolute, site } from '../content/site.ts';
import { appPath, localPath, pageLanguage } from '../i18n.ts';
import Page from '../layouts/Page.astro';
import greetingUrl from '../scripts/greeting.js?url';
import UpdatedOn from './UpdatedOn.astro';

const lang = pageLanguage(Astro.currentLocale);
const words = home[lang];
const path = localPath(lang, '/');
const games = loadGames(lang);
const featured =
  games.find((game) => game.id === 'merge-block') ?? games.find((game) => game.together) ?? games[0];
if (!featured) throw new Error('the shelf needs at least one game');
const open = games.filter((game) => game.id !== featured.id).slice(0, 4);
const quick = games.filter((game) => game.id !== featured.id).slice(0, 4);
const tableGame = games.find((game) => game.together);
const tags = [...new Set(games.flatMap((game) => game.genre))].slice(0, 5);
const updated = latestDay([words.updated, ...games.map((game) => game.page.updated)]);
const gamePath = (id: string) => localPath(lang, `/games/${id}/`);
const playPath = (id: string) => appPath(lang, `/play/${id}`);
const roomsPath = (id: string) => appPath(lang, `/play/${id}/rooms`);
const coverOf = (game: (typeof games)[number]) => game.pictures[0]?.src ?? game.icon;
const metaOf = (game: (typeof games)[number]) =>
  [
    game.genre[0],
    game.seats
      ? `${game.seats.min}–${game.seats.max} ${lang === 'vi' ? 'người' : 'players'}`
      : lang === 'vi'
        ? 'Một mình'
        : 'One player',
  ]
    .filter(Boolean)
    .join(' · ');
/** What the greeting needs of each game, by id: its name in this page's language and where it plays in the app. */
const greetingGames = Object.fromEntries(
  games.map((game) => [game.id, { name: game.name, href: appPath(lang, `/play/${game.id}`) }]),
);
const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': absolute(`${path}#website`),
    url: absolute(path),
    name: site.name,
    description: words.description,
    inLanguage: lang,
    dateModified: updated,
    publisher: { '@id': absolute('/#organization') },
  },
  {
    '@type': 'Organization',
    '@id': absolute('/#organization'),
    name: site.name,
    url: absolute('/'),
    logo: absolute('/icon-512.png'),
    description: words.organization.description,
    email: site.email,
    sameAs: [site.github],
  },
  {
    '@type': 'ItemList',
    name: words.all.heading,
    inLanguage: lang,
    itemListElement: games.map((game, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(gamePath(game.id)),
      name: game.name,
    })),
  },
];
---

<Page title={words.title} description={words.description} path={path} jsonLd={jsonLd}>
  <main id="main" class="shelf">
    <section class="shelf-hero" aria-labelledby="hero-title">
      <article class="feature">
        <a class="feature-cover" href={gamePath(featured.id)} aria-hidden="true" tabindex="-1">
          <img src={coverOf(featured)} alt="" width="1280" height="720" />
          <span class="sticker">{words.hero.sticker}</span>
        </a>
        <div class="feature-body">
          <p class="eyebrow">{words.hero.eyebrow}</p>
          <h1 id="hero-title">{featured.name}</h1>
          <p class="lead">{featured.page.kind}</p>
          <div class="actions start">
            <a class="button primary" href={playPath(featured.id)}>{words.hero.play}</a>
            {
              featured.together && (
                <a class="button secondary" href={roomsPath(featured.id)}>
                  {words.hero.together}
                </a>
              )
            }
          </div>
        </div>
      </article>

      {
        open.length > 0 && (
          <aside class="open-list" aria-labelledby="open-title">
            <h2 id="open-title">{words.open.heading}</h2>
            <ol>
              {open.map((game, index) => (
                <li>
                  <span class="open-num">{String(index + 1).padStart(2, '0')}</span>
                  <a class="open-cover" href={gamePath(game.id)} aria-hidden="true" tabindex="-1">
                    <img src={coverOf(game)} alt="" width="160" height="90" loading="lazy" />
                  </a>
                  <div class="open-words">
                    <a class="open-name" href={gamePath(game.id)}>{game.name}</a>
                    <span class="small">{metaOf(game)}</span>
                  </div>
                </li>
              ))}
            </ol>
            <a class="more" href={localPath(lang, '/games/')}>{words.open.more}</a>
          </aside>
        )
      }
    </section>

    <p class="trust">
      {words.trust.map((item) => <span>{item}</span>)}
    </p>

    <section class="shelf-continue" aria-labelledby="continue-title">
      <h2 id="continue-title">{words.continue.heading}</h2>
      <div
        class="greet"
        data-greeting-card
        data-hello={words.greet.hello}
        data-play={words.greet.play}
        data-not-you={words.greet.notYou}
        data-games={JSON.stringify(greetingGames)}
      >
        <span class="greet-avatar" data-greeting="avatar" aria-hidden="true"></span>
        <p class="greet-hello" data-greeting="hello">{words.greet.helloPlain}</p>
        <a class="button primary" data-greeting="play" href={playPath(featured.id)}>{words.greet.playPlain}</a>
        <a class="button secondary greet-enter" href={appPath(lang, '/play')}>{words.greet.enter}</a>
        <a class="greet-not-you" data-greeting="not-you" href={`/account/profiles?ask=true&lang=${lang}`}></a>
      </div>
      <script is:inline src={greetingUrl}></script>
    </section>

    {
      quick.length > 0 && (
        <section class="shelf-row" aria-labelledby="quick-title">
          <div class="shelf-head">
            <h2 id="quick-title">{words.quick.heading}</h2>
            <a href={localPath(lang, '/games/')}>{words.quick.all}</a>
          </div>
          <ul class="shelf-grid">
            {quick.map((game) => (
              <li>
                <article class="shelf-card">
                  <a class="shelf-cover" href={gamePath(game.id)} aria-hidden="true" tabindex="-1">
                    <img src={coverOf(game)} alt="" width="640" height="360" loading="lazy" />
                  </a>
                  <div class="shelf-card-body">
                    <h3><a href={gamePath(game.id)}>{game.name}</a></h3>
                    <p class="shelf-kind">{game.page.kind}</p>
                    <p class="shelf-meta">{metaOf(game)}</p>
                    <a class="shelf-play" href={playPath(game.id)}>{words.all.play}</a>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      tableGame && (
        <section class="shelf-band" aria-labelledby="together-title">
          <div>
            <p class="eyebrow">{words.together.eyebrow}</p>
            <h2 id="together-title">{words.together.heading}</h2>
            <p>{words.together.text}</p>
          </div>
          <div class="band-actions">
            <a class="button primary" href={roomsPath(tableGame.id)}>{words.together.create}</a>
            <a class="button secondary" href={appPath(lang, '/together')}>{words.together.code}</a>
          </div>
        </section>
      )
    }

    <section class="shelf-row" aria-labelledby="all-title">
      <div class="shelf-head">
        <h2 id="all-title">{words.all.heading}</h2>
        {
          tags.length > 0 && (
            <div class="tags" aria-label={words.all.heading}>
              {tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          )
        }
      </div>
      <ul class="shelf-grid">
        {games.map((game) => (
          <li>
            <article class="shelf-card">
              <a class="shelf-cover" href={gamePath(game.id)} aria-hidden="true" tabindex="-1">
                <img src={coverOf(game)} alt="" width="640" height="360" loading="lazy" />
              </a>
              <div class="shelf-card-body">
                <h3><a href={gamePath(game.id)}>{game.name}</a></h3>
                <p class="shelf-kind">{game.page.kind}</p>
                <p class="shelf-meta">{metaOf(game)}</p>
                <a class="shelf-play" href={playPath(game.id)}>{words.all.play}</a>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <UpdatedOn day={updated} />
  </main>
</Page>
