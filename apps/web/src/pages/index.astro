---
import { loadGames } from '../content/games.ts';
import { home } from '../content/home.ts';
import { absolute, docsUrl, site } from '../content/site.ts';
// The public home page (Vietnamese), served at the root of the players' host (ADR 0042). The app starts at /play.
// The words are in ../content/home.ts. A browser that has played here is sent on to the app by a script in <head>.
import Page from '../layouts/Page.astro';

const games = loadGames();
const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': absolute('/#website'),
    url: absolute('/'),
    name: site.name,
    description: home.description,
    inLanguage: 'vi',
    publisher: { '@id': absolute('/#organization') },
  },
  {
    '@type': 'Organization',
    '@id': absolute('/#organization'),
    name: site.name,
    url: absolute('/'),
    logo: absolute('/icon-512.png'),
    description: home.organization.description,
    email: site.email,
    sameAs: [site.github],
  },
];
---

<Page title={home.title} description={home.description} path="/" returning jsonLd={jsonLd}>
  <main id="main" class="full">
  <div class="hero">
    <img src="/favicon.svg" alt="" width="96" height="96" />
    <h1>{site.name}</h1>
    <p class="lead">{home.lead}</p>
    <div class="actions">
      <a class="button primary" href="/play">{home.play}</a>
    </div>
    <p class="hint"><a href="/guides/install/">{home.installHint}</a></p>
  </div>

  <div class="container">
    <section class="features" aria-label={site.tagline}>
      {
        home.features.map((feature) => (
          <article>
            <span class="icon" aria-hidden="true">
              {feature.icon}
            </span>
            <h2>{feature.title}</h2>
            <p>{feature.text}</p>
          </article>
        ))
      }
    </section>

    <section class="band">
      <h2>{home.games.heading}</h2>
      <ul class="cards">
        {
          games.map((game) => (
            <li>
              <div class="card">
                <div class="card-head">
                  <img class="card-icon" src={game.icon} alt="" width="56" height="56" />
                  <h3 class="card-title">
                    <a href={`/games/${game.id}/`}>{game.name}</a>
                  </h3>
                </div>
                <p>{game.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="more" href="/games/">{home.games.all}</a>
    </section>

    <section class="band">
      <h2>{home.install.heading}</h2>
      <p>{home.install.text}</p>
      <a class="more" href="/guides/install/">{home.install.link}</a>
    </section>

    <section class="band">
      <h2>{home.story.heading}</h2>
      <p>{home.story.text}</p>
    </section>

    <section class="band">
      <h2>{home.questions.heading}</h2>
      <p>{home.questions.text}</p>
      <a class="more" href="/faq/">{home.questions.link}</a>
    </section>

    <section class="band">
      <h2>{home.dev.heading}</h2>
      <p>{home.dev.text}</p>
      <a class="more" href={`${docsUrl}/`}>{home.dev.link}</a>
    </section>
  </div>
  </main>
</Page>
