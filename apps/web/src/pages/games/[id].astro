---
// /games/<gameId>/: one page for each game that has a game.json — ../../views/GamePage.astro.
import { gamePaths } from '../../content/games.ts';
import GamePage from '../../views/GamePage.astro';

export function getStaticPaths() {
  return gamePaths('vi');
}

const { game, others } = Astro.props;
---

<GamePage game={game} others={others} />
