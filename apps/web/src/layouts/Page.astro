---
// The frame of every public page (ADR 0042): head with the title, description, canonical and link-preview tags, the
// structured data a page brings, the header with its navigation and light/dark buttons, and the footer.
// Colours come from the design tokens (ADR 0013). The page's CSP allows no inline script and no inline style: the
// scripts below are files under /_web/, and a JSON-LD block is data, not a script that runs.
import '@tohe/design-tokens/tokens.css';
import themeInitUrl from '@tohe/design-tokens/theme-init.js?url';
import '../styles/site.css';
import { absolute, docsUrl, site } from '../content/site.ts';
import returningUrl from '../scripts/returning.js?url';

interface Props {
  title: string;
  description: string;
  /** The page's own path, with its closing slash: the canonical link and og:url. */
  path: string;
  /** Only the home page: a browser that has played here goes on to the app. */
  returning?: boolean;
  /** Structured data: one JSON-LD block each. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, returning = false, jsonLd = [] } = Astro.props;
const url = absolute(path);
const image = absolute(site.ogImage.path);
// "<" is escaped so no text in the data can close the block.
const blocks = jsonLd.map((data) =>
  JSON.stringify({ '@context': 'https://schema.org', ...data }).replace(/</g, '\\u003c'),
);
const current = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f97316" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {blocks.map((block) => <script is:inline type="application/ld+json" set:html={block} />)}
    {/* Blocking, before the first paint. On the home page a browser that has played here goes to the app; the saved light/dark choice applies everywhere. */}
    {returning && <script is:inline src={returningUrl}></script>}
    <script is:inline src={themeInitUrl}></script>
  </head>
  <body>
    <a class="skip" href="#main">{site.skip}</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} — trang chủ`}>
        <img src="/favicon.svg" alt="" width="40" height="40" />
        <span>{site.name}</span>
      </a>
      <nav aria-label={site.navLabel}>
        {
          site.nav.map(({ label, href }) => (
            <a href={href} aria-current={current(href)}>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="themes" role="group" aria-label={site.themeLabel}>
        {
          site.themes.map(({ choice, icon, label }) => (
            <button type="button" data-choice={choice} aria-label={label} title={label} aria-pressed="false">
              <span aria-hidden="true">{icon}</span>
            </button>
          ))
        }
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <p>{site.footer.line}</p>
      <p class="links">
        <a href="/terms/">{site.footer.terms}</a>
        <a href="/privacy/">{site.footer.privacy}</a>
        <a href={`${docsUrl}/`}>{site.footer.docs}</a>
        <a href={site.github}>{site.footer.github}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </footer>
  </body>
</html>

<script>
  import {
    applyTheme,
    deviceScheme,
    resolveTheme,
    saveChoice,
    savedChoice,
    type ThemeChoice,
  } from '@tohe/design-tokens/theme';

  // The three buttons show and change the choice; "Theo máy" follows the device live.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.themes button')];
  const device = deviceScheme();
  const show = () => {
    const choice = savedChoice();
    applyTheme(resolveTheme(choice, device.matches));
    for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.choice === choice));
  };
  for (const button of buttons) {
    button.addEventListener('click', () => {
      saveChoice(button.dataset.choice as ThemeChoice);
      show();
    });
  }
  device.addEventListener('change', show);
  show();
</script>
