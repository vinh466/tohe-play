{
  "name": "@tohe/contract",
  "version": "0.1.0",
  "description": "Game Contract v1: game manifest, catalog and host/game message protocol (Zod schemas + JSON Schema).",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "build": "node scripts/emit-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^5.0.5"
  }
}
