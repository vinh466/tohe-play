{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ready"
        },
        "gameId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
        },
        "sdkVersion": {
          "type": "string"
        }
      },
      "required": [
        "tohe",
        "type",
        "gameId",
        "sdkVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "save"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "tohe",
        "type",
        "id",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "score"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "number"
        },
        "board": {
          "default": "default",
          "type": "string",
          "maxLength": 40
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "final": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "tohe",
        "type",
        "id",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "exit"
        }
      },
      "required": [
        "tohe",
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "log"
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "tohe",
        "type",
        "level",
        "message"
      ]
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
