{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ready"
        },
        "gameId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
        },
        "sdkVersion": {
          "type": "string"
        }
      },
      "required": [
        "tohe",
        "type",
        "gameId",
        "sdkVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "save"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "tohe",
        "type",
        "id",
        "data"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "score"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "number"
        },
        "board": {
          "default": "default",
          "type": "string",
          "maxLength": 40
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "final": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "tohe",
        "type",
        "id",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "exit"
        }
      },
      "required": [
        "tohe",
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "log"
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "tohe",
        "type",
        "level",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "telemetry"
        },
        "events": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "error"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "stack": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "kind",
                  "message",
                  "count"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "count"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){0,5}$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "count"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "metric"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+){0,5}$"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                },
                "required": [
                  "kind",
                  "name",
                  "value"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "frames"
                  },
                  "buckets": {
                    "minItems": 6,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    }
                  },
                  "slowestMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "stepP50Ms": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "stepP95Ms": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "renderer": {
                    "type": "string",
                    "enum": [
                      "webgl",
                      "canvas"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "buckets",
                  "slowestMs"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "tohe",
        "type",
        "events"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "room.act"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "action": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "tohe",
        "type",
        "id",
        "action"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "room.next"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "tohe",
        "type",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "room.react"
        },
        "reaction": {
          "type": "string",
          "enum": [
            "wave",
            "laugh",
            "wow",
            "clap",
            "hurry",
            "gg",
            "sad",
            "heart"
          ]
        }
      },
      "required": [
        "tohe",
        "type",
        "reaction"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "menu"
        },
        "open": {
          "type": "boolean"
        }
      },
      "required": [
        "tohe",
        "type",
        "open"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "open"
        },
        "what": {
          "type": "string",
          "enum": [
            "leaderboard",
            "rooms"
          ]
        }
      },
      "required": [
        "tohe",
        "type",
        "what"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "settings"
        },
        "muted": {
          "type": "boolean"
        }
      },
      "required": [
        "tohe",
        "type",
        "muted"
      ]
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
