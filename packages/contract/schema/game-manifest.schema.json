{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "type": "number",
      "const": 1
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "entry": {
      "default": "index.html",
      "type": "string"
    },
    "icon": {
      "description": "Path relative to the game root, e.g. icon.svg",
      "type": "string"
    },
    "orientation": {
      "default": "portrait",
      "type": "string",
      "enum": [
        "portrait",
        "landscape",
        "any"
      ]
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "save",
          "scores",
          "rooms"
        ]
      }
    },
    "themes": {
      "default": [
        "light"
      ],
      "description": "Looks the game has. With both, it follows the hub through settings.theme (ADR 0013).",
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "light",
          "dark"
        ]
      }
    },
    "minAge": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    },
    "tags": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20
      }
    },
    "sizeBudgetKb": {
      "default": 3000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 50000
    },
    "rooms": {
      "description": "Online rooms (ADR 0016); required with the \"rooms\" capability",
      "type": "object",
      "properties": {
        "rules": {
          "default": "rules.js",
          "description": "ES module in the build that exports `rules`; the API referees with it",
          "type": "string",
          "pattern": "^[\\w-]+(?:\\/[\\w-]+)*\\.m?js$"
        },
        "seats": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "max": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "bots": {
          "default": [],
          "description": "Bot levels the rules module plays, easiest first; empty if it has no bots",
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,16}$"
          }
        },
        "options": {
          "default": [],
          "maxItems": 24,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                  },
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "vi": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    },
                    "required": [
                      "vi",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label",
                  "default"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                  },
                  "type": {
                    "type": "string",
                    "const": "choice"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "vi": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    },
                    "required": [
                      "vi",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "choices": {
                    "minItems": 2,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                        },
                        "label": {
                          "type": "object",
                          "properties": {
                            "vi": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            },
                            "en": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            }
                          },
                          "required": [
                            "vi",
                            "en"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "default": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label",
                  "choices",
                  "default"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                  },
                  "type": {
                    "type": "string",
                    "const": "multi"
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "vi": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      }
                    },
                    "required": [
                      "vi",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "choices": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                        },
                        "label": {
                          "type": "object",
                          "properties": {
                            "vi": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            },
                            "en": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 60
                            }
                          },
                          "required": [
                            "vi",
                            "en"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "default": {
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "label",
                  "choices",
                  "default"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "seats"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "protocol"
  ],
  "additionalProperties": false
}
