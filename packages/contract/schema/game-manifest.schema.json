{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "type": "number",
      "const": 1
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 200
    },
    "entry": {
      "default": "index.html",
      "type": "string"
    },
    "icon": {
      "description": "Path relative to the game root, e.g. icon.svg",
      "type": "string"
    },
    "orientation": {
      "default": "portrait",
      "type": "string",
      "enum": [
        "portrait",
        "landscape",
        "any"
      ]
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "save",
          "scores"
        ]
      }
    },
    "minAge": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    },
    "tags": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20
      }
    },
    "sizeBudgetKb": {
      "default": 3000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 50000
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "protocol"
  ],
  "additionalProperties": false
}
