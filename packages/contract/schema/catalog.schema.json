{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manifest": {
            "type": "object",
            "properties": {
              "$schema": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
              },
              "protocol": {
                "type": "number",
                "const": 1
              },
              "description": {
                "default": "",
                "type": "string",
                "maxLength": 200
              },
              "entry": {
                "default": "index.html",
                "type": "string"
              },
              "icon": {
                "description": "Path relative to the game root, e.g. icon.svg",
                "type": "string"
              },
              "orientation": {
                "default": "portrait",
                "type": "string",
                "enum": [
                  "portrait",
                  "landscape",
                  "any"
                ]
              },
              "capabilities": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "save",
                    "scores"
                  ]
                }
              },
              "minAge": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 18
              },
              "tags": {
                "default": [],
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20
                }
              },
              "sizeBudgetKb": {
                "default": 3000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 50000
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "protocol",
              "description",
              "entry",
              "orientation",
              "capabilities",
              "minAge",
              "tags",
              "sizeBudgetKb"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\/[^/]+\\/$"
          },
          "sizeKb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "manifest",
          "path",
          "sizeKb"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generatedAt",
    "games"
  ],
  "additionalProperties": false
}
