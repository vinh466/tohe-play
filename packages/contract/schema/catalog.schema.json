{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manifest": {
            "type": "object",
            "properties": {
              "$schema": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "The standard name: English, or a proper name such as Tiến Lên (ADR 0048)"
              },
              "names": {
                "description": "The name per language tag, when it differs from the standard one (ADR 0048)",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
              },
              "protocol": {
                "type": "number",
                "const": 1
              },
              "description": {
                "default": "",
                "description": "The standard description, in the language of the standard name (ADR 0048)",
                "type": "string",
                "maxLength": 200
              },
              "descriptions": {
                "description": "The description per language tag (ADR 0048)",
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "entry": {
                "default": "index.html",
                "type": "string"
              },
              "icon": {
                "description": "Path relative to the game root, e.g. icon.svg",
                "type": "string"
              },
              "orientation": {
                "default": "portrait",
                "type": "string",
                "enum": [
                  "portrait",
                  "landscape",
                  "any"
                ]
              },
              "capabilities": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "save",
                    "scores",
                    "rooms",
                    "shell",
                    "ranked"
                  ]
                }
              },
              "themes": {
                "default": [
                  "light"
                ],
                "description": "Looks the game has. With both, it follows the hub through settings.theme (ADR 0013).",
                "minItems": 1,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              },
              "minAge": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 18
              },
              "tags": {
                "default": [],
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 20
                }
              },
              "sizeBudgetKb": {
                "default": 3000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 50000
              },
              "rooms": {
                "description": "Online rooms (ADR 0016); required with the \"rooms\" capability",
                "type": "object",
                "properties": {
                  "rules": {
                    "default": "rules.js",
                    "description": "ES module in the build that exports `rules`; the API referees with it",
                    "type": "string",
                    "pattern": "^[\\w-]+(?:\\/[\\w-]+)*\\.m?js$"
                  },
                  "seats": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 8
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 8
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "bots": {
                    "default": [],
                    "description": "Bot levels the rules module plays, easiest first; empty if it has no bots",
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{2,16}$"
                    }
                  },
                  "options": {
                    "default": [],
                    "maxItems": 24,
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                            },
                            "type": {
                              "type": "string",
                              "const": "boolean"
                            },
                            "label": {
                              "type": "object",
                              "properties": {
                                "vi": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                },
                                "en": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                }
                              },
                              "required": [
                                "vi",
                                "en"
                              ],
                              "additionalProperties": false
                            },
                            "default": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "type",
                            "label",
                            "default"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                            },
                            "type": {
                              "type": "string",
                              "const": "choice"
                            },
                            "label": {
                              "type": "object",
                              "properties": {
                                "vi": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                },
                                "en": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                }
                              },
                              "required": [
                                "vi",
                                "en"
                              ],
                              "additionalProperties": false
                            },
                            "choices": {
                              "minItems": 2,
                              "maxItems": 12,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                                  },
                                  "label": {
                                    "type": "object",
                                    "properties": {
                                      "vi": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 60
                                      },
                                      "en": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 60
                                      }
                                    },
                                    "required": [
                                      "vi",
                                      "en"
                                    ],
                                    "additionalProperties": false
                                  }
                                },
                                "required": [
                                  "id",
                                  "label"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "default": {
                              "type": "string",
                              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                            }
                          },
                          "required": [
                            "id",
                            "type",
                            "label",
                            "choices",
                            "default"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
                            },
                            "type": {
                              "type": "string",
                              "const": "multi"
                            },
                            "label": {
                              "type": "object",
                              "properties": {
                                "vi": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                },
                                "en": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 60
                                }
                              },
                              "required": [
                                "vi",
                                "en"
                              ],
                              "additionalProperties": false
                            },
                            "choices": {
                              "minItems": 1,
                              "maxItems": 12,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                                  },
                                  "label": {
                                    "type": "object",
                                    "properties": {
                                      "vi": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 60
                                      },
                                      "en": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 60
                                      }
                                    },
                                    "required": [
                                      "vi",
                                      "en"
                                    ],
                                    "additionalProperties": false
                                  }
                                },
                                "required": [
                                  "id",
                                  "label"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "default": {
                              "maxItems": 12,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,31}$"
                              }
                            }
                          },
                          "required": [
                            "id",
                            "type",
                            "label",
                            "choices",
                            "default"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "rules",
                  "seats",
                  "bots",
                  "options"
                ],
                "additionalProperties": false
              },
              "ranked": {
                "description": "Ranked runs (ADR 0030); required with the \"ranked\" capability",
                "type": "object",
                "properties": {
                  "verify": {
                    "default": "verify.js",
                    "description": "ES module in the build that exports `verify`; the API replays ranked runs with it",
                    "type": "string",
                    "pattern": "^[\\w-]+(?:\\/[\\w-]+)*\\.m?js$"
                  },
                  "board": {
                    "default": "default",
                    "description": "The board ranked runs count on",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "minMsPerMove": {
                    "default": 100,
                    "description": "A person needs at least this long per move; a faster run is held for a person to look at",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60000
                  },
                  "maxMoves": {
                    "default": 20000,
                    "description": "Most moves a ranked run can have",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  }
                },
                "required": [
                  "verify",
                  "board",
                  "minMsPerMove",
                  "maxMoves"
                ],
                "additionalProperties": false
              },
              "identity": {
                "description": "What the game asks of its player (ADR 0045); without it, any profile opens it and a table asks for a name",
                "type": "object",
                "properties": {
                  "play": {
                    "default": "any",
                    "description": "What opening the game asks for (ADR 0043): any, named or account",
                    "type": "string",
                    "enum": [
                      "any",
                      "named",
                      "account"
                    ]
                  },
                  "rooms": {
                    "description": "The least a table of this game asks for; only with the \"rooms\" capability (default named)",
                    "type": "string",
                    "enum": [
                      "named",
                      "account"
                    ]
                  }
                },
                "required": [
                  "play"
                ],
                "additionalProperties": false
              },
              "entries": {
                "description": "Kinds of entry the game opens itself (ADR 0045); with \"share\", the build ships entries/share.json",
                "maxItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "share"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "version",
              "protocol",
              "description",
              "entry",
              "orientation",
              "capabilities",
              "themes",
              "minAge",
              "tags",
              "sizeBudgetKb"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\/[^/]+\\/$"
          },
          "sizeKb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "manifest",
          "path",
          "sizeKb"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generatedAt",
    "games"
  ],
  "additionalProperties": false
}
