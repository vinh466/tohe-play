{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lockVersion": {
      "type": "number",
      "const": 1
    },
    "packs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "manifest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The sha256 of the pack version's manifest in the Studio"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z0-9][a-z0-9-]*(?:\\/[a-z0-9][a-z0-9-]*)*$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "image",
                    "spritesheet",
                    "tileset",
                    "audio",
                    "font",
                    "palette"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "ext": {
                  "type": "string",
                  "pattern": "^[a-z0-9]{1,8}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "licence": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
                },
                "attribution": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "kind",
                "sha256",
                "ext",
                "bytes",
                "licence"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "version",
          "manifest",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lockVersion",
    "packs"
  ],
  "additionalProperties": false
}
