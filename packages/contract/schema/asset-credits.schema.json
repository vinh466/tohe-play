{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "licences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
            }
          },
          "attributions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assets": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^[a-z0-9][a-z0-9-]*(?:\\/[a-z0-9][a-z0-9-]*)*$"
                  }
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "assets",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "version",
          "licences",
          "attributions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "packs"
  ],
  "additionalProperties": false
}
