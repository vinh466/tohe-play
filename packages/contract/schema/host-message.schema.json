{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "init"
        },
        "profile": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "avatar": {
              "type": "string"
            }
          },
          "required": ["id", "name"],
          "additionalProperties": false
        },
        "locale": {
          "type": "string"
        },
        "settings": {
          "type": "object",
          "properties": {
            "muted": {
              "type": "boolean"
            }
          },
          "required": ["muted"],
          "additionalProperties": false
        },
        "save": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["tohe", "type", "profile", "locale", "settings", "save", "seed"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "pause"
        }
      },
      "required": ["tohe", "type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "resume"
        }
      },
      "required": ["tohe", "type"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "settings"
        },
        "settings": {
          "type": "object",
          "properties": {
            "muted": {
              "type": "boolean"
            }
          },
          "required": ["muted"],
          "additionalProperties": false
        }
      },
      "required": ["tohe", "type", "settings"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tohe": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "result"
        },
        "replyTo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "required": ["tohe", "type", "replyTo", "ok"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
