# Two sites, one per host (ADR 0042):
# - :8080, the hub: the public pages (apps/web, /srv/web) at the root, the PWA (/srv) and a same-origin reverse proxy
#   to the API, so the session cookie (M1) stays first-party. connect-src names the hub's own WebSocket (the rooms hub, ADR 0016) as well: CSP3's 'self' covers it, older Safari
#   does not.
# - :8081, the console (ADR 0027): its app at the root and the API's console routes, on a host of its own with a
#   session of its own. Nothing else of the hub is served there.
# Which path goes where comes from the map in @tohe/routes: hub-routes.caddy and console-routes.caddy, generated from
# it, name each site's namespaces; this file says how each is served. A path in no namespace answers 404.
# Env: API_UPSTREAM (host:port of the API), GAMES_ORIGIN (where game iframes come from),
#      TOHE_TRUSTED_PROXIES (CIDRs of proxies in front of this server, e.g. a cluster's ingress; default: none),
#      TOHE_CLIENT_IP_HEADERS (headers those proxies put the visitor's address in, e.g. CF-Connecting-IP),
#      TOHE_SECURITY_CONTACT (the address /.well-known/security.txt names; unset: no security.txt),
#      TOHE_HUB_URL (this host's own public URL, e.g. https://toheplay.io.vn: the public pages' canonical and Open
#      Graph links, the app's own og:url and og:image, the sitemap and robots.txt need absolute URLs; unset:
#      /sitemap.xml answers 404),
#      TOHE_DOCS_URL (the docs host's URL, for the public pages' links to the developer docs).
# Both URLs are read when the container starts, so one image serves every environment (ADR 0021): the build writes
# [[[env "TOHE_HUB_URL"]]] and [[[env "TOHE_DOCS_URL"]]] into the public pages and the app's page (web.Dockerfile).
{
	admin off
	servers {
		# Only these peers may tell Caddy who the visitor is. The default trusts loopback alone, i.e. nobody: on UAT
		# and in compose this server is the edge. Trusting a wide range lets anyone in it spoof the address the API
		# rate-limits by (ADR 0021).
		trusted_proxies static {$TOHE_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers {$TOHE_CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

# The snippet hubSitemap, generated from the map in @tohe/routes: it answers /sitemap.xml below.
import /etc/caddy/hub-sitemap.caddy

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Browsers ignore this over plain HTTP (UAT, local), so it only takes effect behind HTTPS. includeSubDomains:
		# every host of the domain is Tò He's and served over HTTPS (ADR 0040, 0042); no preload list.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# The hub's CSP on everything but a link preview's card (ADR 0044), which keeps the API's own: it allows nothing but
	# the card's one script, by its hash. @notLinkPreview comes from hub-routes.caddy, generated from @tohe/routes.
	header @notLinkPreview Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$GAMES_ORIGIN}; frame-src {$GAMES_ORIGIN}; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport}; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'"

	# @apiProxy, @publicStaticRevalidate, @publicStaticImmutable, @appPage, @appStaticImmutable, @appStaticRevalidate,
	# @platformGenerated. Then link previews (ADR 0044): a known crawler asking for /r/<code> or /s/<code> is rewritten
	# to the API's card, /api/previews/<r|s>/<code>, which Caddy runs before any `handle` below and @apiProxy passes
	# through untouched — never into a template; people get the app's page, unchanged.
	import /etc/caddy/hub-routes.caddy

	handle @apiProxy {
		reverse_proxy {$API_UPSTREAM} {
			# The API rate-limits sign-in by client address: hand it the one worked out above, not a proxy's.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The public pages (apps/web): the home page at the root, the games, the guides, the FAQ, about, the terms and the
	# privacy notice, each a folder with an index.html under /srv/web (so none is the app's index.html), plus /og.png
	# and /llms.txt. file_server serves a folder's index.html and answers a path without its closing slash with a
	# redirect to the one with it. They are indexed, and their CSP is their own: no script and no style but files of the
	# page's own (the build puts them under /_web/), no frame, no form, no connection. The build wrote the hub's and the
	# docs' URLs as template actions, filled in from the environment here.
	handle @publicStaticRevalidate {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Cache-Control "no-cache"
		templates {
			between [[[ ]]]
		}
		file_server
	}
	handle @publicStaticImmutable {
		root * /srv/web
		header X-Robots-Tag "noindex"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The app's pages: whatever the path inside its namespaces, the app's index.html, which routes it. Not indexed. The
	# build wrote the hub's URL and the path asked for as template actions into the page's link preview (og:url,
	# og:image); the path is HTML-escaped by the template.
	handle @appPage {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		# /r/<code> and /s/<code> answer a crawler the API's card and a person this page: a cache in front keeps them apart.
		header @linkPreviewPaths Vary "User-Agent"
		rewrite * /index.html
		templates {
			between [[[ ]]]
		}
		file_server
	}

	# The app's files, as they are, not indexed either; a name that is not there is a 404.
	handle @appStaticImmutable {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle @appStaticRevalidate {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		# /index.html, which the service worker caches, is the same page as @appPage's: its link preview is filled in too.
		templates {
			between [[[ ]]]
		}
		file_server
	}

	# The platform's files: robots.txt, generated from the map at build time (a template: its Sitemap line takes
	# TOHE_HUB_URL), sitemap.xml, written here from the same map, and security.txt (RFC 9116), written here only when
	# TOHE_SECURITY_CONTACT names an address. Its Expires is written on each request 360 days ahead: under a year, as
	# the RFC recommends, and never stale while the setting is kept.
	handle @platformGenerated {
		header Cache-Control "no-cache"
		handle /robots.txt {
			root * /srv
			templates
			file_server
		}
		handle /sitemap.xml {
			import hubSitemap
		}
		handle /.well-known/security.txt {
			@noContact expression `{env.TOHE_SECURITY_CONTACT} == ""`
			error @noContact 404
			header Content-Type "text/plain; charset=utf-8"
			templates
			respond <<TXT
				Contact: mailto:{{ env "TOHE_SECURITY_CONTACT" }}
				Expires: {{ dateInZone "2006-01-02T15:04:05Z" (now | dateModify "+8640h") "UTC" }}
				Preferred-Languages: vi, en

				TXT 200
		}
		handle {
			error 404
		}
	}

	# Anything else is in no namespace.
	handle {
		error 404
	}

	# A real 404 — a small page of the app's own, never indexed. Other errors (a 502 while the API restarts) keep
	# Caddy's empty answer.
	handle_errors 404 {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}

# The console (ADR 0027, 0042), on its own host: console.<domain> in production, port 4721 locally and 4821 on UAT.
# Its own app from /srv/console, and only the API's console routes; the API answers those on this host alone and
# authenticates them with the console's own session cookie. Never indexed, no service worker, no robots.txt. Its CSP
# is stricter than the hub's: no WebSocket, no inline styles, no images from the games origin; it frames that origin
# only to watch a ranked run in the game itself (ADR 0032).
:8081 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src {$GAMES_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow"
	}

	# @apiProxy (the API's console routes), @consolePage, @consoleStaticImmutable, @consoleStaticRevalidate.
	import /etc/caddy/console-routes.caddy

	handle @apiProxy {
		reverse_proxy {$API_UPSTREAM} {
			# The API rate-limits sign-in by client address: hand it the one worked out above, not a proxy's.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The console's pages: whatever the path inside its namespaces, its index.html, which routes it.
	handle @consolePage {
		root * /srv/console
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle @consoleStaticImmutable {
		root * /srv/console
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle @consoleStaticRevalidate {
		root * /srv/console
		header Cache-Control "no-cache"
		file_server
	}

	# Anything else — the hub's pages, the API's other routes, /admin — is in no namespace of this host.
	handle {
		error 404
	}

	handle_errors 404 {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-cache"
		header Content-Type "text/plain; charset=utf-8"
		respond "Không có trang này." 404
	}
}
