# Hub: the PWA plus a same-origin reverse proxy to the API, so the session cookie (M1) stays first-party.
# Env: API_UPSTREAM (host:port of the API), GAMES_ORIGIN (where game iframes come from).
{
	admin off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$GAMES_ORIGIN}; frame-src {$GAMES_ORIGIN}; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
