# Hub: the PWA plus a same-origin reverse proxy to the API, so the session cookie (M1) stays first-party.
# connect-src names the hub's own WebSocket (the rooms hub, ADR 0016) as well: CSP3's 'self' covers it, older Safari
# does not.
# Which path goes where comes from the map in @tohe/routes (ADR 0042): hub-routes.caddy, generated from it, names the
# namespaces; this file says how each is served. A path in no namespace answers 404.
# Env: API_UPSTREAM (host:port of the API), GAMES_ORIGIN (where game iframes come from),
#      TOHE_TRUSTED_PROXIES (CIDRs of proxies in front of this server, e.g. a cluster's ingress; default: none),
#      TOHE_CLIENT_IP_HEADERS (headers those proxies put the visitor's address in, e.g. CF-Connecting-IP),
#      TOHE_SECURITY_CONTACT (the address /.well-known/security.txt names; unset: no security.txt).
{
	admin off
	servers {
		# Only these peers may tell Caddy who the visitor is. The default trusts loopback alone, i.e. nobody: on UAT
		# and in compose this server is the edge. Trusting a wide range lets anyone in it spoof the address the API
		# rate-limits by (ADR 0021).
		trusted_proxies static {$TOHE_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers {$TOHE_CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Browsers ignore this over plain HTTP (UAT, local), so it only takes effect behind HTTPS. includeSubDomains:
		# every host of the domain is Tò He's and served over HTTPS (ADR 0040, 0042); no preload list.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: {$GAMES_ORIGIN}; frame-src {$GAMES_ORIGIN}; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport}; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'"
	}

	# @apiProxy, @consolePage, @appPage, @appStaticImmutable, @appStaticRevalidate, @platformGenerated, and the redirects
	# as `redir` directives (the root leads to /play with a 302; the app's old paths answer 301 for the links in emails
	# already sent), which Caddy runs before any `handle` below.
	import /etc/caddy/hub-routes.caddy

	# The admin console (ADR 0027): its own app at /admin/, built into this image. Never indexed, and stricter than the
	# hub: no WebSocket, no inline styles, no images from the games origin; it frames that origin only to watch a ranked
	# run in the game itself (ADR 0032). Its header replaces the hub's CSP set above.
	redir /admin /admin/ 308
	handle @consolePage {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src {$GAMES_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Robots-Tag "noindex, nofollow"
		}
		root * /srv
		@adminImmutable path /admin/assets/*
		header @adminImmutable Cache-Control "public, max-age=31536000, immutable"
		@adminMutable not path /admin/assets/*
		header @adminMutable Cache-Control "no-cache"
		try_files {path} /admin/index.html
		file_server
	}

	handle @apiProxy {
		reverse_proxy {$API_UPSTREAM} {
			# The API rate-limits sign-in by client address: hand it the one worked out above, not a proxy's.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The app's pages: whatever the path inside its namespaces, the app's index.html, which routes it. Not indexed.
	handle @appPage {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# The app's files, as they are, not indexed either; a name that is not there is a 404.
	handle @appStaticImmutable {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle @appStaticRevalidate {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		file_server
	}

	# The platform's files: robots.txt, generated from the map at build time, and security.txt (RFC 9116), written here
	# only when TOHE_SECURITY_CONTACT names an address. Its Expires is written on each request 360 days ahead: under
	# a year, as the RFC recommends, and never stale while the setting is kept.
	handle @platformGenerated {
		header Cache-Control "no-cache"
		handle /robots.txt {
			root * /srv
			file_server
		}
		handle /.well-known/security.txt {
			@noContact expression `{env.TOHE_SECURITY_CONTACT} == ""`
			error @noContact 404
			header Content-Type "text/plain; charset=utf-8"
			templates
			respond <<TXT
				Contact: mailto:{{ env "TOHE_SECURITY_CONTACT" }}
				Expires: {{ dateInZone "2006-01-02T15:04:05Z" (now | dateModify "+8640h") "UTC" }}
				Preferred-Languages: vi, en

				TXT 200
		}
		handle {
			error 404
		}
	}

	# Anything else is in no namespace.
	handle {
		error 404
	}

	# A real 404 — a small page of the app's own, never indexed. Other errors (a 502 while the API restarts) keep
	# Caddy's empty answer.
	handle_errors 404 {
		root * /srv
		header X-Robots-Tag "noindex"
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
