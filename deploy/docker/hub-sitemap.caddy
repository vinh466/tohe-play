# Generated from @tohe/routes (packages/routes/src/map.ts) by `pnpm --filter @tohe/routes build`.
# Do not edit: change the map and regenerate (ADR 0042, docs/architecture/hosts-and-paths.md).
# The sitemap: the public pages the map marks as indexed, with absolute URLs from the hub’s own public URL, and
# each page’s language alternates (hreflang, ADR 0047).
(hubSitemap) {
