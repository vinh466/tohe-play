@consolePage path /admin /admin/*
@appPage path / /welcome /welcome/* /sign-in /sign-in/* /register /register/* /password /password/* /profiles /profiles/* /account /account/* /legal /legal/* /data /data/* /play /play/* /rooms /rooms/* /r /r/* /room /room/* /replay /replay/*
