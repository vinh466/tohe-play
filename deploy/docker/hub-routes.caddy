# Generated from @tohe/routes (packages/routes/src/map.ts) by `pnpm --filter @tohe/routes build`.
# Do not edit: change the map and regenerate (ADR 0042, docs/architecture/hosts-and-paths.md).
# The namespaces of the hub’s host as named matchers; Caddyfile.hub serves each and answers 404 to the rest.
@apiProxy path /api /api/*
@publicStaticRevalidate path / /games /games/* /guides /guides/* /faq /faq/* /about /about/* /promise /promise/* /terms /terms/* /privacy /privacy/* /en /en/* /og.png /llms.txt
@publicStaticImmutable path /_web /_web/*
@appPage path /play /play/* /together /together/* /account /account/* /r /r/* /s /s/*
@appStaticImmutable path /assets /assets/*
@appStaticRevalidate path /index.html /manifest.webmanifest /sw.js /registerSW.js /workbox-* /theme-init.js /favicon.svg /apple-touch-icon.png /icon-192.png /icon-512.png /screenshots /screenshots/*
@platformGenerated path /robots.txt /sitemap.xml /.well-known /.well-known/*
# Link previews: a crawler asking for a link of a previewed namespace gets the API’s card for it; people the app.
@linkPreview {
	path_regexp linkPreview ^/(r|s)/([0-9A-Za-z-]{1,20})$
	header_regexp linkPreviewCrawler User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|WhatsApp/|LinkedInBot|Zalo)
	not header_regexp linkPreviewBrowser User-Agent (?i)(Mobile|FBAN|FBAV|FB_IAB|Instagram)
	not query app=*
}
rewrite @linkPreview /api/previews/{re.linkPreview.1}/{re.linkPreview.2}
# Every other request: the hub’s CSP (the card keeps its own).
@notLinkPreview {
	not {
		path_regexp ^/(r|s)/([0-9A-Za-z-]{1,20})$
		header_regexp User-Agent (?i)(facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|WhatsApp/|LinkedInBot|Zalo)
		not header_regexp User-Agent (?i)(Mobile|FBAN|FBAV|FB_IAB|Instagram)
		not query app=*
	}
}
# The previewed links, whoever asks: the answer varies with the User-Agent.
@linkPreviewPaths path /r/* /s/*
