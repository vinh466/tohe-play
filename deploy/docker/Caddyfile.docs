# Docs: the developer documentation (static Astro build), at the root of its host (ADR 0042).
# Env: PUBLIC_HUB_URL (the hub's origin: /play on this host leads to the hub's /play), TOHE_DOCS_URL (this host's own
#      URL, for canonical links, the sitemap and llms.txt). Both are read when the container starts, so one image serves
#      every environment (ADR 0021): the build writes [[[env "TOHE_DOCS_URL"]]] where the docs' URL goes (web.Dockerfile).
{
	admin off
}

:8080 {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Browsers ignore this over plain HTTP (UAT, local). includeSubDomains: every host of the domain is Tò He's and
		# served over HTTPS (ADR 0040, 0042); no preload list.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The docs used to live under /docs/ (before ADR 0042 moved them to the root): links and bookmarks that still say
	# /docs/<page> answer 301 to /<page>, the query kept.
	@docsRoot path_regexp docsRoot ^/docs/?$
	redir @docsRoot /?{query} 301
	@docsPage path_regexp docsPage ^/docs/(.+)$
	redir @docsPage /{re.docsPage.1}?{query} 301

	# The hub's catalog is its /play, and the hub's address is decided at run time, not at build time. Unset (a
	# misconfigured container) it falls back to this host's home page rather than a broken redirect.
	@hubKnown expression `{env.PUBLIC_HUB_URL} != "" && path('/play', '/play/')`
	redir @hubKnown {env.PUBLIC_HUB_URL}/play 302
	@hubUnknown path /play /play/
	redir @hubUnknown / 302

	# Unusual delimiters: only the placeholders the build wrote are template actions; "{{" in the docs is just text.
	templates {
		# file_server serves .xml (the sitemap) as text/xml.
		mime text/html text/xml application/xml text/plain
		between [[[ ]]]
	}

	file_server

	handle_errors {
		rewrite * /404.html
		templates {
			mime text/html
			between [[[ ]]]
		}
		file_server
	}
}
