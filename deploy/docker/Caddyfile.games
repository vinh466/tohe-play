# Games origin: immutable /<id>/<version>/ builds + catalog.json, on a site of its own in production (ADR 0039).
# Env: HUB_ORIGINS (space-separated origins allowed to embed games), PUBLIC_HUB_URL (the hub's origin; this origin's
#      `/` leads to its /play).
# games-csp.caddy is generated from @tohe/contract's gameContentSecurityPolicy() by `@tohe/games-host build`.
{
	admin off
}

:8080 {
	encode zstd gzip
	root * /srv

	header X-Content-Type-Options nosniff
	# Browsers ignore this over plain HTTP (UAT, local). includeSubDomains: every host of the domain is Tò He's and
	# served over HTTPS (ADR 0040, 0042); no preload list.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Game pages are meant only inside the hub's frame: search engines leave the whole origin out (ADR 0039).
	header X-Robots-Tag "noindex, nofollow"
	# The games origin is the same site as the hub (ADR 0040): ask browsers to keep it apart by origin rather than by site
	# — its own agent cluster, and a process of its own where they isolate by origin (ADR 0046). Ignored where unknown.
	header Origin-Agent-Cluster "?1"

	# Nothing to see at the origin's own front page, a name people may type: it leads to the hub's catalog (ADR 0039).
	redir / {$PUBLIC_HUB_URL}/play 302

	@catalog path /catalog.json
	header @catalog {
		Cache-Control "no-cache"
		Access-Control-Allow-Origin "*"
	}

	# Not the front page: a redirect cached for a year would outlive a change of the hub's URL.
	@build not path /catalog.json /
	header @build Cache-Control "public, max-age=31536000, immutable"
	import /etc/caddy/games-csp.caddy

	file_server
}
