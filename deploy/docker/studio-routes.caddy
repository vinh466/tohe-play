# Generated from @tohe/routes (packages/routes/src/map.ts) by `pnpm --filter @tohe/routes build`.
# Do not edit: change the map and regenerate (ADR 0042, docs/architecture/hosts-and-paths.md).
# The namespaces of the Studio’s host as named matchers; Caddyfile.hub serves each in the Studio’s site and answers
# 404 to the rest.
@apiProxy path /api/studio /api/studio/*
@studioPage path / /packs /packs/* /styles /styles/* /sign-in
@studioStaticImmutable path /assets /assets/*
@studioStaticRevalidate path /index.html /theme-init.js /favicon.svg
