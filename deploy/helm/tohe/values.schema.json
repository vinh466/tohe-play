{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tò He chart values",
  "description": "Unknown keys are rejected so a typo fails the render instead of being ignored. Cross-field rules (required URLs, distinct hosts, one API replica, secrets) are checked by the templates (tohe.validate) with messages that name the value.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "origin": {
      "type": "string",
      "pattern": "^(https?://[^/?#]+/?)?$",
      "description": "An http(s) origin with no path, or empty."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trustedProxies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "clientIpHeaders": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "publicUrls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hub": {
          "$ref": "#/definitions/origin"
        },
        "games": {
          "$ref": "#/definitions/origin"
        },
        "site": {
          "$ref": "#/definitions/origin"
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicaCount": {
          "type": "integer"
        },
        "migrateOnStartup": {
          "type": "boolean"
        },
        "allowedHosts": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "hub": {
      "$ref": "#/definitions/web"
    },
    "games": {
      "$ref": "#/definitions/web"
    },
    "site": {
      "$ref": "#/definitions/web"
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": ["builtin", "external"]
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            },
            "passwordKey": {
              "type": "string",
              "minLength": 1
            },
            "maxPoolSize": {
              "type": "integer",
              "minimum": 1
            },
            "external": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "sslMode": {
                  "enum": ["Disable", "Allow", "Prefer", "Require", "VerifyCA", "VerifyFull"]
                },
                "connectionStringKey": {
                  "type": "string"
                }
              }
            },
            "builtin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "storage": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "size": {
                      "type": "string",
                      "minLength": 1
                    },
                    "storageClass": {
                      "type": "string"
                    }
                  }
                },
                "resources": {
                  "$ref": "#/definitions/resources"
                },
                "podSecurityContext": {
                  "type": "object"
                },
                "securityContext": {
                  "type": "object"
                },
                "nodeSelector": {
                  "$ref": "#/definitions/stringMap"
                },
                "tolerations": {
                  "type": "array"
                },
                "affinity": {
                  "type": "object"
                },
                "pullPolicy": {
                  "enum": ["Always", "IfNotPresent", "Never"]
                }
              }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgresPassword": {
              "type": "string"
            },
            "telemetryOperatorToken": {
              "type": "string"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaceLabels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h)$"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "scraperNamespaceLabels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
